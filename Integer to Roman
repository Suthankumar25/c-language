class Solution {
public:
    string intToRoman(int num) {
        // Parallel arrays matching values with their Roman numeral representations
        const int values[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
        const string symbols[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};
        
        string result = "";
        
        // Loop through all mapped values from largest to smallest
        for (int i = 0; i < 13; ++i) {
            // Append the symbol and subtract value as long as num is larger
            while (num >= values[i]) {
                num -= values[i];
                result += symbols[i];
            }
        }
        
        return result;
    }
};
