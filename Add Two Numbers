class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
        ListNode dummy(0); // Temporary node to build the result list
        ListNode* tail = &dummy;
        int carry = 0;
        
        // Loop while there are digits left in l1 or l2, or if there is a leftover carry
        while (l1 != nullptr || l2 != nullptr || carry != 0) {
            int sum = carry;
            
            if (l1 != nullptr) {
                sum += l1->val;
                l1 = l1->next;
            }
            
            if (l2 != nullptr) {
                sum += l2->val;
                l2 = l2->next;
            }
            
            carry = sum / 10; // Calculate new carry
            tail->next = new ListNode(sum % 10); // Insert current digit
            tail = tail->next;
        }
        
        return dummy.next;
    }
};
