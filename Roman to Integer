class Solution {
public:
    int romanToInt(string s) {
        // Map characters to their respective Roman values using an array lookup for speed
        int values[256] = {0};
        values['I'] = 1;
        values['V'] = 5;
        values['X'] = 10;
        values['L'] = 50;
        values['C'] = 100;
        values['D'] = 500;
        values['M'] = 1000;
        
        int total = 0;
        int n = s.length();
        
        for (int i = 0; i < n; ++i) {
            // If current value is less than the next value, subtract it
            if (i + 1 < n && values[(unsigned char)s[i]] < values[(unsigned char)s[i + 1]]) {
                total -= values[(unsigned char)s[i]];
            } else {
                // Otherwise, add it
                total += values[(unsigned char)s[i]];
            }
        }
        
        return total;
    }
};
