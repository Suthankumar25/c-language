#include <stdbool.h>
#include <string.h>

bool isValid(char* s) {
    int len = strlen(s);
    
    // An odd length string can never be valid
    if (len % 2 != 0) {
        return false;
    }
    
    // Create an array to act as our stack
    char stack[len];
    int top = -1;
    
    for (int i = 0; i < len; i++) {
        char current = s[i];
        
        // If it's an opening bracket, push it onto the stack
        if (current == '(' || current == '{' || current == '[') {
            stack[++top] = current;
        } 
        // If it's a closing bracket, check for a valid match
        else {
            // Stack is empty but we have a closing bracket -> Invalid
            if (top == -1) {
                return false;
            }
            
            char openBracket = stack[top--];
            
            if ((current == ')' && openBracket != '(') ||
                (current == '}' && openBracket != '{') ||
                (current == ']' && openBracket != '[')) {
                return false;
            }
        }
    }
    
    // If stack is empty, all brackets were matched correctly
    return top == -1;
}
